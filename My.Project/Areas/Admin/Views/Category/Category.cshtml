@using Infrastructure.ViewModels
@using My.Project.Areas.Admin.ViewModel
@model IEnumerable<CategoryVM>

<!-- BREADCRUMB-->
<section class="au-breadcrumb">
    <div class="section__content section__content--p30">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="au-breadcrumb-content">
                        <div class="au-breadcrumb-left">
                            <span class="au-breadcrumb-span">You are here:</span>
                            <ul class="list-unstyled list-inline au-breadcrumb__list">
                                <li class="list-inline-item active">
                                    <a href="#">Home</a>
                                </li>
                                <li class="list-inline-item seprate">
                                    <span>/</span>
                                </li>
                                <li class="list-inline-item">Category</li>
                            </ul>
                        </div>
                        <a asp-area="Admin" asp-controller="Category" asp-action="CreateCategory" class="au-btn au-btn-icon au-btn--green">
                            <i class="zmdi zmdi-plus"></i>add item
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END BREADCRUMB-->
<!-- STATISTIC-->
<section>
    <div>
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12">
                    <!-- USER DATA-->
                    <div class="user-data m-b-30">
                        <h3 class="title-3 m-b-30">
                            <i class="zmdi zmdi-account-calendar"></i>Category List
                        </h3>
                        @if (ViewBag.isCategoryDelete != null)
                        {
                            if (Convert.ToString(ViewBag.isCategoryDelete) == "1")
                            {
                                <h3>Product deleted</h3>
                            }
                            else
                            {
                                <h3>error while deleting</h3>
                            }
                        }
                        <table class="table table-borderless align-middle mt-3">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    @* <th>Product Image</th> *@
                                    <th>Product Name</th>
                                    @* <th>Product Details</th> *@
                                    <th>IsActive</th>
                                    <th>Create Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Count() > 0)
                                {
                                    int index = 1;
                                    foreach (var item in Model)
                                    {
                                        <!-- Blog 1 -->
                                        <tr>
                                            <td>@index</td>
                                            <td>
                                                <div class="table-data__info">
                                                    <h6>@item.CategoryName</h6>
                                                </div>
                                            </td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="text-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger">No</span>
                                                }
                                            </td>
                                            <td>@item.CreateDate</td>
                                            <td>
                                                <div class="fs-5 row">
                                                    <!-- Button trigger modal -->
                                                    <a asp-area="Admin" asp-controller="Category" asp-action="DeleteCategory" asp-route-id="@item.CategoryId" class="btn btn-danger">
                                                        Delete
                                                    </a>
                                                    <!-- Modal -->
                                                    <div class="modal fade" id="staticBackdrop5" data-bs-backdrop="static"
                                                    data-bs-keyboard="false" tabindex="-1"
                                                    aria-labelledby="staticBackdrop5Label" aria-hidden="true">
                                                        <div class="modal-dialog">
                                                            <div class="modal-content">
                                                                <div class="modal-header">
                                                                    <h1 class="modal-title fs-5" id="staticBackdrop5Label">
                                                                        Delete
                                                                        Confirmation
                                                                    </h1>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                                    aria-label="Close"></button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    Are You Sure you want to delete this?
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary"
                                                                    data-bs-dismiss="modal">
                                                                        Cancel
                                                                    </button>
                                                                    <a  class="btn btn-primary">Confirm</a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <!-- Button trigger modal -->
                                                    <a asp-area="Admin" asp-controller="Category" asp-action="UpdateCategory" asp-route-id="@item.CategoryId" class="btn btn-primary">
                                                        Edit
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                }
                            </tbody>
                        </table>
