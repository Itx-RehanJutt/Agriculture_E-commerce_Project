@using DbEntities.Entities
@using Infrastructure.ViewModels
@using Microsoft.AspNetCore.Http
@using My.Project.Utilities
@{
    // Retrieve session data
    var loginUser = Context.Session.GetObject<SignInResponseVM>("User");
    ViewData["Title"] = "Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - My.Project</title>
    <!-- Fontfaces CSS-->
    <link href="~/CoolAdmin-master/CoolAdmin-master/css/font-face.css" rel="stylesheet" media="all">
    <link href="~/CoolAdmin-master/CoolAdmin-master/vendor/font-awesome-4.7/css/font-awesome.min.css" rel="stylesheet" media="all">
    <link href="~/CoolAdmin-master/CoolAdmin-master/vendor/font-awesome-5/css/fontawesome-all.min.css" rel="stylesheet" media="all">
    <link href="~/CoolAdmin-master/CoolAdmin-master/vendor/mdi-font/css/material-design-iconic-font.min.css" rel="stylesheet" media="all">

    <!-- Bootstrap CSS-->
    <link href="~/CoolAdmin-master/CoolAdmin-master/vendor/bootstrap-4.1/bootstrap.min.css" rel="stylesheet" media="all">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />

    <!-- Vendor CSS-->
    <link href="~/CoolAdmin-master/CoolAdmin-master/vendor/animsition/animsition.min.css" rel="stylesheet" media="all">
    <link href="~/CoolAdmin-master/CoolAdmin-master/vendor/bootstrap-progressbar/bootstrap-progressbar-3.3.4.min.css" rel="stylesheet" media="all">
    <link href="~/CoolAdmin-master/CoolAdmin-master/vendor/wow/animate.css" rel="stylesheet" media="all">
    <link href="~/CoolAdmin-master/CoolAdmin-master/vendor/css-hamburgers/hamburgers.min.css" rel="stylesheet" media="all">
    <link href="~/CoolAdmin-master/CoolAdmin-master/vendor/slick/slick.css" rel="stylesheet" media="all">
    <link href="~/CoolAdmin-master/CoolAdmin-master/vendor/select2/select2.min.css" rel="stylesheet" media="all">
    <link href="~/CoolAdmin-master/CoolAdmin-master/vendor/perfect-scrollbar/perfect-scrollbar.css" rel="stylesheet" media="all">
    <link href="~/CoolAdmin-master/CoolAdmin-master/vendor/vector-map/jqvmap.min.css" rel="stylesheet" media="all">

    <!-- Main CSS-->
    <link href="~/CoolAdmin-master/CoolAdmin-master/css/theme.css" rel="stylesheet" media="all">
    <link href="~/css/Style.css" rel="stylesheet" media="all">
    <link href="~/css/admin.css" rel="stylesheet" media="all">
</head>
<body class="animsition">
    <div class="page-wrapper">
        <div>
            <!-- Navbar -->
            <nav class="navbar navbar-expand-lg px-3 h-100">
                <div class="container-fluid d-flex justify-content-between align-items-center">
                    <!-- Logo -->
                    <@* a class="navbar-brand" href="">
                        <img src="" alt="Logo" height="40" />
                    </a> *@
                    <!-- Search Box -->
                    <div class="d-flex align-items-center">
                        <input type="text"
                               class="form-control search-input"
                               placeholder="Search" />
                        <button class="icon-btn ms-2">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>

                    <!-- Icons and User Profile -->
                    <div class="d-flex align-items-center">
                        <!-- User Profile -->
                        <div class="d-flex align-items-center">
                            <img src="~/AdminImage/user4.svg"
                                 alt="profile"
                                 class="user-profile" />
                            <span class="user-text">Hi,@loginUser.Name</span>
                        </div>
                    </div>
                </div>
            </nav>
        </div>
        <!-- MENU SIDEBAR-->
        <aside class="menu-sidebar2">
            <div class="logo">
                <a href="#">
                    <img src="~/Logo Pic/Logo.svg" alt="Agriculture Logo" />
                </a>
            </div>

            <div class="menu-sidebar2__content js-scrollbar1">
                <div class="account2">
                    <div class="image img-cir img-120">
                        <img src="~/AdminImage/AdminImage.jpg" alt="Rehan Nawaz" />
                    </div>
                    <h4 class="name">@loginUser.Name</h4>
                    @* <a >Sign out</a> *@
                </div>
                <div class="sidebar">
                    <a href="/Admin/Admin.html" class="side-link active"><i class="fa-solid fa-house me-2"></i>Dashboard</a>
                    <a asp-action="Category" asp-controller="Category" asp-area="Admin" class="side-link"><i class="fa-solid fa-comment me-2"></i>Category</a>
                        <a asp-action="Product" asp-controller="Product" asp-area="Admin" class="side-link"><i class="fa-solid fa-blog me-2"></i>Products</a>
                    <a href="./Service.html" class="side-link"><i class="fa-solid fa-hand-holding-dollar me-2"></i>Service</a>
                    @* // <a href="./Team.html" class="side-link"><i class="fa-solid fa-users-rectangle me-2"></i>Rating</a> *@
                    <a href="./User.html" class="side-link"><i class="fa-solid fa-user me-2"></i>Users</a>
                    <a href="./Card.html" class="side-link"><i class="fa-regular fa-hard-drive me-2"></i>Card</a>
                    <a href="./FeedBack.html" class="side-link"><i class="fa-solid fa-comment me-2"></i>FeedBack</a>
                    @* <a href="./Comment.html" class="side-link"><i class="fa-solid fa-comment me-2"></i>Comment</a> *@
                    <a href="./GetService.html" class="side-link"><i class="fa-solid fa-hand-holding-dollar me-2"></i>Service Request</a>
                    <hr>
                    <a asp-action="signout" asp-controller="Home" asp-area="Admin"><i class="fa-solid fa-right-from-bracket me-2"></i>Logout</a>
                </div>
            </div>
        </aside>
        <!-- END MENU SIDEBAR-->
        <!-- PAGE CONTAINER-->
        <div class="page-container2">
            
            <!-- END HEADER DESKTOP-->
            @RenderBody()
            <!-- END PAGE CONTAINER-->
        </div>
       
    </div>
    <!-- Jquery JS-->
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/jquery-3.2.1.min.js"></script>
    <!-- Bootstrap JS-->
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/bootstrap-4.1/popper.min.js"></script>
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/bootstrap-4.1/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
            integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
            crossorigin="anonymous"></script>
    <!-- Vendor JS       -->
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/slick/slick.min.js">
    </script>
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/wow/wow.min.js"></script>
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/animsition/animsition.min.js"></script>
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/bootstrap-progressbar/bootstrap-progressbar.min.js">
    </script>
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/counter-up/jquery.waypoints.min.js"></script>
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/counter-up/jquery.counterup.min.js">
    </script>
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/circle-progress/circle-progress.min.js"></script>
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/chartjs/Chart.bundle.min.js"></script>
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/select2/select2.min.js">
    </script>
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/vector-map/jquery.vmap.js"></script>
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/vector-map/jquery.vmap.min.js"></script>
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/vector-map/jquery.vmap.sampledata.js"></script>
    <script src="~/CoolAdmin-master/CoolAdmin-master/vendor/vector-map/jquery.vmap.world.js"></script>

    <!-- Main JS-->
    <script src="~/CoolAdmin-master/CoolAdmin-master/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
