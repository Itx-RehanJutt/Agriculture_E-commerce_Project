@{
    ViewData["Title"] = "Cart List";
    // Layout = null;
}

<!-- Main CSS-->
<link href="~/CoolAdmin-master/CoolAdmin-master/css/theme.css" rel="stylesheet" media="all">
<link rel="stylesheet" href="~/css/CartList.css" asp-append-version="true" />
<!-- BREADCRUMB-->
<section class="au-breadcrumb bg-dark m-t-75">
    <div class="section__content section__content--p30">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="au-breadcrumb-content">
                        <div class="au-breadcrumb-left">
                            <span class="au-breadcrumb-span">You are here:</span>
                            <ul class="list-unstyled list-inline au-breadcrumb__list">
                                <li class="list-inline-item active">
                                    <a asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li class="list-inline-item seprate">
                                    <span>/</span>
                                </li>
                                <li class="list-inline-item">List Of Cart Item</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END BREADCRUMB-->
@(await Component.InvokeAsync("CartList")))
<!-- Jquery JS-->
@section Scripts {
    <script src="~/js/JavaScript.js" asp-append-version="true"></script>
}
