@using Infrastructure.ViewModels
@model IEnumerable<ProductVM>
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<!-- Hero Section -->
<section class="hero-section">
    <div class="container mt-4 text-center">
        <h1 class="fw-bolder fs-1">
            Natural Products <span class="d-lg-block d-inline">
                For Lovers of <span class="text-warning">
                    <img loading="lazy" src="~/Images/Section_Image/Heading 1 → decor-line.webp.svg" alt="arrow"
                         class="position-absolute img-fluid health" />Healthy
                </span>
            </span> Organic Food
        </h1>
        <a href="#" class="btn btn-success btn-lg text-white fw-bolder px-4 py-3">Discover More</a>
    </div>
</section>
@* <!-- Product Section --> *@
<section>
    <div class="container p-5">
        <p style="color: #EEC044; font-family: Covered By Your Grace; text-align:center;">Recently Added</p>
        <p style="color: #1F1E17; font-family: Manrope; text-align:center;" class="mb-4 h1 fw-bold">Latest Product</p>
        <div class="row">
            @if (Model != null && Model.Count() > 0)
            {
                foreach (var item in Model)
                {
                    <!-- Product 1 -->
                    <div class="col-md-4 mb-4 btn">
                        <div class="product-card product" data-id="@item.ProductId">
                            <img src="~/Product/Product_Pic/@item.ProductImage" alt="@item.ProductName" class="product-img">
                            <h5 class="product-name">@item.ProductName</h5>
                            <p class="product-price">$@item.Price</p>
                            <span class="star-icon">★</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>No products available.</p> <!-- Show a message if no products exist -->
            }
         </div>
     </div>
</section>

<!-- Offer Section -->
<section class="offer-section" style="background-image: url(Images/Section_Image/wheats.webp.svg);
      background-repeat: no-repeat; background-position:bottom;">
    <div class="container text-center">
        <h2>What We Offer</h2>
        <div class="row px-md-5">
            <div class="col-md-4 col-sm-6 mb-3">
                <div class="card">
                    <img loading="lazy" src="~/Images/Card_Image/service-05.webp.png" class="card-img-top" alt="Agriculture Products">
                    <div class="card-body">
                        <h5 class="card-title">Agriculture Products</h5>
                        <p class="card-text">High-quality farm products from fields.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6 mb-3">
                <div class="card">
                    <img loading="lazy" loading="lazy" src="~/Images/Card_Image/service-06.webp.svg" class="card-img-top" alt="Organic Products">
                    <div class="card-body">
                        <h5 class="card-title">Organic Products</h5>
                        <p class="card-text">Fresh organic produce for healthy living.</p>
                    </div>
                </div>
            </div>
            <img loading="lazy" loading="lazy" src="./Section_Image/wheats.webp.svg" class="position-absolute" alt="">
            <div class="col-md-4">
                <div class="card">
                    <img loading="lazy" src="~/Images/Card_Image/service-07.webp.svg" class="card-img-top" alt="Dairy Products">
                    <div class="card-body">
                        <h5 class="card-title">Dairy Products</h5>
                        <p class="card-text">Pure and fresh dairy from organic farms.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

