<!-- Meet Our Farmers -->
<section class="farmers_section">
    <div class="container">
        <h2>Meet Our Farmers</h2>
        <div class="row justify-content-center">
            <div class="col-lg-3 col-md-4 col-sm-6 col-8 mb-4">
                <img loading="lazy" src="~/Images/Section_Image/Link - avatar → team-01.webp.svg" alt="Farmer 1" class="img-fluid">
                <h5>Kevin Smith</h5>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-8 mb-4">
                <img loading="lazy" src="~/Images/Section_Image/Link - avatar → team-02.webp.svg" alt="Farmer 2">
                <h5>Jessica Brown</h5>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-8 mb-4">
                <img loading="lazy" src="~/Images/Section_Image/Link - avatar → team-03.webp.svg" alt="Farmer 3">
                <h5>David Martin</h5>
            </div>
        </div>
    </div>
</section>
<!--Video Section-->
<img loading = "lazy" src="~/Images/Home_Page_Pic/Frame 3384410.svg" alt="Video" class="img-fluid">
