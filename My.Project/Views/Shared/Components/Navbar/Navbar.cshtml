                        @*     <a class="nav-link" asp-controller="Home" asp-action="ProductDetail" >Product Details</a> *@
                        @* </li> *@
                        @* <li class="nav-item"> *@
                        @*     <a class="nav-link" href="#">News</a> *@
                        @* </li> *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Shop">Shop</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
