                                <a asp-controller="Cart" asp-action="CartItem" class="nav-link"><i class="fa-solid fa-cart-shopping fa-lg"></i>
                                    <span class="badge rounded-pill">0</span>
                                </a>
                            </div>
                            <a href="#" class="nav-link p-2 rounded-circle me-2" style="border:1px solid #eec044;"><i class="fa-solid fa-phone-volume fa-xl " style="color: #eec044;"></i></a>
