@using Infrastructure.ViewModels
@model IEnumerable<CartItemVM>
<link rel="stylesheet" href="~/css/CartList.css" asp-append-version="true" >

<div class="container mt-5">
    <h4 class="mb-4">Categories</h4>
    <div class="row">

        <!-- Left Side -->
        <div class="col-md-8">
            @if (Model != null && Model.Count() > 0)
            {
                <div class="d-flex align-items-center mb-3">
                    <input type="checkbox" class="form-check-input me-2 selectAll">
                    <span>Select All (@Model.Count() Item(s))</span>
                    <button class="btn btn-link text-danger ms-auto delete-all-cart-items"><i class="fa fa-trash"></i> Delete</button>
                </div>
                foreach (var item in Model)
                    {            
                        <!-- Cart Item -->
                        <div class="cart-item d-flex align-items-center">
                        <input type="checkbox" class="form-check-input me-3 product-checkbox" value="@item.ProductId">
                            <img src="~/Product/Product_Pic/@item.ProductImage" alt="@item.ProductName" class="me-3">
                            <div class="flex-grow-1">
                                <h6>Fresh and Quality product</h6>
                                @* <p class="text-muted mb-1">OKS®, Color Family: C Type Cable</p> *@
                                <span class="badge bg-success">Buy 2 Punnets, save Rs. 100</span>
                            </div>
                            <div>
                                <p class="price mb-1">Rs. @item.Price</p>
                                @* <p class="original-price">Rs. @item.Price</p> *@
                            </div>
                            <div class="ms-3 d-flex align-items-center">
                            <form asp-controller="Cart" asp-action="UpdateMultipleCartItems" method="post">
                                    <button type="button" class="btn btn-outline-secondary btn-sm updatequantity" data-product-id="@item.ProductId" data-change="-1" ><i class="fa fa-minus"></i></button>
                                    <input type="text" id="quantity-@item.ProductId" class="mx-2 text-center w-25" name="quantity" readonly value="@item.Quantity">
                                    <input type="hidden" name="ProductId" value="@item.ProductId" />
                                    <button type="button" class="btn btn-outline-secondary btn-sm updatequantity" data-product-id="@item.ProductId" data-change="1"><i class="fa fa-plus"></i></button>
                                </form>
                            </div>
                            <div class="ms-3">
                                <i class="fa fa-heart text-muted"></i>
                                <i class="fa btn fa-trash text-danger ms-3 delete-cart-item" data-product-id="@item.ProductId"></i>
                            </div>
                        </div>
                    }
                }
        </div>
        <!-- Right Side -->
        <div class="col-md-4">
            @(await Component.InvokeAsync("Cart"))
        </div>
    </div>
</div>

