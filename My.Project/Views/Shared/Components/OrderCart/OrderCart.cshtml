@using Infrastructure.ViewModels
<!--Cart Card Start-->
@model OrderCartVM
<link rel="stylesheet" href="~/css/CartList.css" asp-append-version="true">

@if (Model != null)
{
                <div class="summary-box">
                    <h5>Order Summary</h5>
                    <div class="d-flex justify-content-between mt-3">
                        <span class="quantity">Subtotal (@Model.Quantity items)</span>
                        <span class="totalPrice">Rs. @Model.TotalPrice</span>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <span>Shipping Fee</span>
                        <span>Rs. 500</span>
                    </div>
        @* <div class="mt-3"> *@
        @*     <input type="text" class="form-control" placeholder="Enter Voucher Code"> *@
        @*     <button class="btn btn-primary w-100 mt-2">Apply</button> *@
        @* </div> *@
                    <hr>
                    <div class="d-flex justify-content-between">
                        <h6>Total Price</h6>
                        <h6 class="totalPrice">Rs. @Model.TotalPrice </h6>
                    </div>
           <form asp-controller="Order" asp-action="CreateOrder" method="post">
                <input type="hidden" asp-for="Quantity" value="@Model.Quantity" />
                <input type="hidden" asp-for="CustomerId" value="@Model.CustomerId" />
                <input type="hidden" asp-for="ProductId" value="@Model.ProductId" />
                <input type="hidden" asp-for="TotalPrice" value="@Model.TotalPrice" />
                <button type="submit" class="btn btn-success w-100 mt-3">Proceed to Checkout</button>
           </form>
           </div>
}