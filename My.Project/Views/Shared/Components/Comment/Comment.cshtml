<!-- Contact section -->
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<section>
     <div class="container container-lg container-md px-sm-5 pb-5">
         <div class="row justify-content-center">
             <div class="col-12 d-block px-0 d-md-none">
                 <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13282.7139908684!2d73.02709265!3d33.66549145!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x38df95906a03cfff%3A0x2b2f1c1c99b676ce!2sInternational%20Islamic%20University%20Islamabad%20(IIUI)!5e0!3m2!1sen!2s!4v1731848162938!5m2!1sen!2s" class="border-0 img-fluid h-100 w-100" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" alt="Image on top"></iframe>
             </div>
             <div class="col-md-4 pe-0 d-none d-md-block">
                 <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13282.7139908684!2d73.02709265!3d33.66549145!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x38df95906a03cfff%3A0x2b2f1c1c99b676ce!2sInternational%20Islamic%20University%20Islamabad%20(IIUI)!5e0!3m2!1sen!2s!4v1731848162938!5m2!1sen!2s" class="border-0 img-fluid h-100 w-100" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" alt="Image on left"></iframe>
            </div>
            <div class="col-md-6 contact-section">
                <div class="container p-sm-5 text-start">
                    <form class="mt-5">
                        <h1 class="fw-bold mb-3">Write a Message</h1>
                        <div class="mb-3 d-flex">
                            <input type="text" class="py-3 px-3 me-2 rounded-1 border border-light form-input"
                                   placeholder="Your Name">
                            <input type="email" class="py-3 px-3 rounded-1 border border-light form-input"
                                   placeholder="Your Email Address">
                        </div>
                        <div class="mb-3">
                            <textarea class="form-control form-input" rows="4" placeholder="Write a Message"></textarea>
                        </div>
                        <button type="submit" class="btn btn-success">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- End Contact section -->