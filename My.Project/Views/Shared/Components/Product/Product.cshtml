@using Infrastructure.ViewModels
@model ProductVM
<!--Start {Product Details-->
<!-- Breadcrumb Section with Background Image -->
@if (Model != null)
{
    <link rel="stylesheet" href="~/css/ProductDetail.css" asp-append-version="true" />
        <section class="breadcrumb-section py-5 text-center d-flex align-items-center">
            <div class="container">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-center">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item"><a href="#">Shop</a></li>
                        <li class="breadcrumb-item"><a href="#">Agriculture</a></li>
                    <li class="breadcrumb-item text-white active">@Model.ProductName</li>
                    </ol>
                    <h1 class="fw-bold text-white">Our Shop</h1>
                </nav>
            </div>
        </section>

        <!-- Product Section -->
        <div class="mt-5">
            <div class="row justify-content-center main-product">

                <!-- Product Image -->
                <div class="col-lg-4">
                    <img src="~/Product/Product_Pic/@Model.ProductImage" class="img-fluid h-100" alt="@Model.ProductName">
                </div>
                <!-- Product Details -->
                <div class="col-lg-5">
                    <div class="d-flex">
                        <p class="fw-bold align-self-start h1">@Model.ProductName</p>
                        <div class="d-flex flex-column mt-3">
                            <p class="product-price ms-md-4 mb-0">$@Model.Price</p>
                            <p class="product-description"><small>(1 Customer Review)</small></p>
                        </div>
                    </div>
                    <hr>
                    <p class="product-description">
                        Aliquam hendrerit a augue insuscipit. Etiam aliquam massa quis des mauris
                        commodo venenatis ligula commodo leez sed blandit convallis dignissim
                        onec vel pellentesque neque.
                    </p>
                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                    <!-- Quantity Selector -->
                    <div class="quantity-container d-flex align-Models-center">
                        <label for="quantity" class="form-label fw-semibold fs-5 me-3">Choose Quantity </label>
                        <div class="input-group mb-3 border border-1 rounded-3" style="width: 20%;">
                            <input type="hidden" name="ProductId" value="@Model.ProductId" />
                            <input type="hidden" id="redirectTo" name="redirectTo" value="" />
                            <input type="text" class="form-control p-0 text-center bg-light rounded-start" name="quantity" readonly value="1" min="1" id="quantity">
                            <div class="d-flex flex-column">
                                <button class="btn btn-light btn-sm border rounded-0" type="button" id="increaseQuantity">+</button>
                                <button class="btn btn-light btn-sm border rounded-0" type="button" id="decreaseQuantity">-</button>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="mt-3">
                        <button type="submit" class="btn add-to-cart-btn me-2 text-white px-3 py-2 fw-semibold" onclick="setRedirect('Order')">
                            Buy Now
                        </button>
                        <button type="submit" class="btn wishlist-btn text-white px-3 py-2 fw-semibold" onclick="setRedirect('Shop')">Add to cart</button>
                    </div>
                    </form>

                    <!-- Social Share -->
                    <div class="social-share mt-4 d-flex">
                        <span class="fw-bold fs-6 me-2 align-self-center">Share with Friends</span>
                        <div class="">
                            <a href="#"><i class="fa-brands fa-facebook rounded-circle icon_colors p-2"></i></a>
                            <a href="#"><i class="fa-brands fa-twitter rounded-circle icon_colors p-2"></i></a>
                            <a href="#"><i class="fa-brands fa-linkedin rounded-circle icon_colors p-2"></i></a>
                            <a href="#"><i class="fa-brands fa-pinterest rounded-circle icon_colors p-2"></i></a>
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <div class="row mt-5 justify-content-center">
                    <div class="col-md-8">
                        <h4 class="section-title">Description</h4>
                        <p class="product-description">
                            @Model.ProductDiscription
                        </p>
                    </div>
                </div>
        <!-- Reviews -->
         @* @(await Component.InvokeAsync("Rating")); *@
                <!-- Rating Form Start -->
                <div class="row mt-4 justify-content-center">
                    <div class="col-md-8">
                        <h4 class="section-title">review for @Model.ProductName</h4>
                        <div class="review">
                            <img src="~/Product/Review Pic/review_person.svg" alt="User" width="60">
                            <div class="review-details">
                                <h6>Kevin Martin</h6>
                                <p><small class="product-price">July 10, 2022</small></p>
                                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed blandit convallis dignissim.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Rating Form Start -->
        <div id="reviewsSection"></div>
        <!-- Add a Review -->
        <div class="row my-4 justify-content-center">
            <div class="col-md-8 product-description">
                <input type="checkbox" name="checkbox" id="checkbox">
                <span>Save my name, email, and website in this browser for the next time I comment.</span>
                <p class="mt-3">
                    Your Rating:
                    <span class="Rating-Icon btn pe-0 mb-1" id="Rating-Icon-1">★</span>
                    <span class="Rating-Icon btn p-0 mb-1" id="Rating-Icon-2 ">★</span>
                    <span class="Rating-Icon btn p-0 mb-1" id="Rating-Icon-3 ">★</span>
                    <span class="Rating-Icon btn p-0 mb-1" id="Rating-Icon-4 ">★</span>
                    <span class="Rating-Icon btn p-0 mb-1" id="Rating-Icon-5 ">★</span>
                </p>
                <form class="review-form" id="reviewForm">
                    <textarea class="form-control" id="reviewText" rows="5" placeholder="Your Review"></textarea>
                    <div class="d-flex justify-content-between">
                        <input type="text" class="form-control me-3" id="reviewerName" placeholder="Your Name">
                        <input type="email" class="form-control" id="reviewerEmail" placeholder="Email Address">
                    </div>
                    <button type="submit" class="btn add-to-cart-btn text-white px-3 py-2 fw-semibold">Submit Review</button>
                </form>
            </div>
        </div>
    </div>
</div>
}

<!--End Product Details-->
